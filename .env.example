# ==========================================
# Day 26 - MCP & Function Calling Environment
# ==========================================

# 1. Google Gemini API Key (get free at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. WeatherAPI.com Key (optional for mock, get free key at https://www.weatherapi.com/)
WEATHERAPI_KEY=your_weatherapi_key_here

# 3. Remote FastMCP Server Configuration (04-lab)
PORT=8085
MCP_SERVER_URL=http://localhost:8085/mcp
MCP_TRANSPORT=streamable-http

# 4. Auth Server Token Configuration (03-production)
MCP_AUTH_TOKEN=dev-token-abc123
